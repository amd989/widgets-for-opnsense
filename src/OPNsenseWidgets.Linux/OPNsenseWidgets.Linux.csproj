<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Linux daemon (opnsense-widgetsd): polls OPNsense and serves the widget pages to desktop widgets
    (KDE Plasma) on 127.0.0.1, talking to them over a WebSocket with the same protocol as the
    Windows Widget Board.
    Publish: dotnet publish src/OPNsenseWidgets.Linux -c Release -r linux-x64
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OPNsenseWidgets.Linux</RootNamespace>
    <AssemblyName>opnsense-widgetsd</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- A desktop helper, not a server: workstation GC roughly halves resident memory. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OPNsenseWidgets.Core\OPNsenseWidgets.Core.csproj" />
  </ItemGroup>

</Project>
