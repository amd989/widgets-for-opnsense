{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${totalLeases} devices",
              "size": "Small",
              "weight": "Bolder",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "$when": "${newCount > 0}",
          "items": [
            {
              "type": "TextBlock",
              "text": "● ${newCount} new",
              "size": "Small",
              "color": "Accent",
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "Carousel",
      "spacing": "None,
      "$when": "${pageCount > 0}",
      "pages": [
        {
          "type": "CarouselPage",
          "$data": "${pages}",
          "items": [
            {
              "type": "Image",
              "$data": "${col1}",
              "url": "${img}",
              "size": "Stretch",
              "spacing": "Small"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "No devices found",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Medium",
      "$when": "${totalLeases == 0}"
    }
  ]
}
