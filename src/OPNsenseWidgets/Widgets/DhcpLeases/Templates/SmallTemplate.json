{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${totalLeases} devices",
              "size": "Small",
              "weight": "Bolder",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "$when": "${newCount > 0}",
          "items": [
            {
              "type": "TextBlock",
              "text": "● ${newCount} new",
              "size": "Small",
              "color": "Accent",
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "$data": "${leases}",
      "style": "${style}",
      "spacing": "Small",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${hostname}",
                  "size": "Small",
                  "weight": "Bolder",
                  "spacing": "None"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${time}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None"
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${meta}",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "$when": "${meta != ''}"
        }
      ],
      "showBorder": true,
      "roundedCorners": true
    },
    {
      "type": "TextBlock",
      "text": "No devices found",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Medium",
      "$when": "${totalLeases == 0}"
    }
  ]
}