{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${totalLeases} devices",
              "weight": "Bolder",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${lastRefresh}",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "$when": "${newCount > 0}",
          "items": [
            {
              "type": "TextBlock",
              "text": "● ${newCount} new",
              "size": "Small",
              "color": "Accent",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "● ${activeCount} active",
              "size": "Small",
              "color": "Good",
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "Image",
      "url": "${sparkline}",
      "size": "Stretch",
      "height": "24px",
      "spacing": "Small"
    },
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "24h",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "now",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Container",
              "$data": "${col1}",
              "style": "${style}",
              "spacing": "Small",
              "items": [
                {
                  "type": "ColumnSet",
                  "spacing": "None",
                  "columns": [
                    {
                      "type": "Column",
                      "width": "stretch",
                      "items": [
                        {
                          "type": "TextBlock",
                          "text": "${hostname}",
                          "size": "Small",
                          "weight": "Bolder",
                          "spacing": "None"
                        }
                      ]
                    },
                    {
                      "type": "Column",
                      "width": "auto",
                      "items": [
                        {
                          "type": "TextBlock",
                          "text": "${time}",
                          "size": "Small",
                          "isSubtle": true,
                          "spacing": "None"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "TextBlock",
                  "text": "${meta}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "$when": "${meta != ''}"
                }
              ],
              "showBorder": true,
              "roundedCorners": true
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Container",
              "$data": "${col2}",
              "style": "${style}",
              "spacing": "Small",
              "items": [
                {
                  "type": "ColumnSet",
                  "spacing": "None",
                  "columns": [
                    {
                      "type": "Column",
                      "width": "stretch",
                      "items": [
                        {
                          "type": "TextBlock",
                          "text": "${hostname}",
                          "size": "Small",
                          "weight": "Bolder",
                          "spacing": "None"
                        }
                      ]
                    },
                    {
                      "type": "Column",
                      "width": "auto",
                      "items": [
                        {
                          "type": "TextBlock",
                          "text": "${time}",
                          "size": "Small",
                          "isSubtle": true,
                          "spacing": "None"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "TextBlock",
                  "text": "${meta}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "$when": "${meta != ''}"
                }
              ],
              "roundedCorners": true,
              "showBorder": true
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${displayedLeases} of ${totalLeases}",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small",
      "$when": "${totalLeases > 0}"
    }
  ]
}