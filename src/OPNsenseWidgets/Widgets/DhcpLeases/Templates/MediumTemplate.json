{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${totalLeases} devices",
              "weight": "Bolder",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${lastRefresh}",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "$when": "${newCount > 0}",
          "items": [
            {
              "type": "TextBlock",
              "text": "● ${newCount} new",
              "size": "Small",
              "color": "Accent",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "● ${activeCount} active",
              "size": "Small",
              "color": "Good",
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "Image",
      "url": "${sparkline}",
      "size": "Stretch",
      "height": "24px",
      "spacing": "Small"
    },
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "24h",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "now",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "Carousel",
      "spacing": "Small",
      "$when": "${pageCount > 0}",
      "pages": [
        {
          "type": "CarouselPage",
          "$data": "${pages}",
          "items": [
            {
              "type": "ColumnSet",
              "spacing": "None",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "Image",
                      "$data": "${col1}",
                      "url": "${img}",
                      "size": "Stretch",
                      "spacing": "Small"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "Image",
                      "$data": "${col2}",
                      "url": "${img}",
                      "size": "Stretch",
                      "spacing": "Small"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Page 1 of ${pageCount} \u00b7 ${displayedLeases} of ${totalLeases}",
      "size": "Small",
      "isSubtle": true,
      "spacing": "ExtraLarge",
      "$when": "${totalLeases > 0}"
    }
  ]
}
