{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "↓ ${downloadSpeed}",
              "size": "Small",
              "color": "Good",
              "weight": "Bolder",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "↑ ${uploadSpeed}",
              "size": "Small",
              "color": "Accent",
              "weight": "Bolder",
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "Image",
      "url": "${chartImage}",
      "size": "Stretch",
      "height": "32px",
      "spacing": "Small",
      "$when": "${sampleCount > 1}"
    },
    {
      "type": "TextBlock",
      "text": "${interfaceName}",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small",
      "$when": "${sampleCount > 2}"
    },
    {
      "type": "TextBlock",
      "text": "Collecting data\u2026",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small",
      "$when": "${sampleCount < 2}"
    }
  ]
}