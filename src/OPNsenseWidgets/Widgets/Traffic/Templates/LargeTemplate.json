{
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "\u2193 ${downloadSpeed}",
              "weight": "Bolder",
              "color": "Good",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "\u2191 ${uploadSpeed}",
              "weight": "Bolder",
              "color": "Accent",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${lastRefresh}",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "Image",
      "url": "${legendImage}",
      "size": "Stretch",
      "height": "22px",
      "spacing": "Small",
      "$when": "${legendImage != ''}"
    },
    {
      "type": "TextBlock",
      "text": "\u2193 Download",
      "size": "Small",
      "color": "Good",
      "weight": "Bolder",
      "spacing": "Small",
      "$when": "${sampleCount > 1}"
    },
    {
      "type": "Image",
      "url": "${downloadChart}",
      "size": "Stretch",
      "height": "130px",
      "spacing": "None",
      "$when": "${sampleCount > 1}"
    },
    {
      "type": "TextBlock",
      "text": "\u2191 Upload",
      "size": "Small",
      "color": "Accent",
      "weight": "Bolder",
      "spacing": "Small",
      "$when": "${sampleCount > 1}"
    },
    {
      "type": "Image",
      "url": "${uploadChart}",
      "size": "Stretch",
      "height": "130px",
      "spacing": "None",
      "$when": "${sampleCount > 1}"
    },
    {
      "type": "TextBlock",
      "text": "Collecting data\u2026",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Medium",
      "$when": "${sampleCount < 2}"
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "$when": "${sampleCount > 1}",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Total \u2193 ${totalIn}",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Total \u2191 ${totalOut}",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${interfaceName} \u00b7 ${sampleCount} samples",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small"
    }
  ]
}
